// Select only terms generated by the native CPeaceOffer constructor.  Follow
// the persistent branch of 98bf50: selected bit, dependency notification,
// typed selected vector, term +118 recalculation, dependency notification.
// +120 is a speculative score query and rolls its temporary changes back.
struct PeaceProvinceRequest {
    int32_t ids[16]{};
    unsigned count=0;
    char beneficiary[4]{};
};

static bool peace_province_parse_request(const char* token,const char* beneficiary,
    PeaceProvinceRequest& request) noexcept {
    request=PeaceProvinceRequest{};
    if (!token || !beneficiary) return false;
    if (!strcmp(token,"-")) return !strcmp(beneficiary,"-");
    if (strlen(beneficiary)!=3) return false;
    for (unsigned i=0;i<3;++i)
        if (!((beneficiary[i]>='A' && beneficiary[i]<='Z')
            || (beneficiary[i]>='0' && beneficiary[i]<='9'))) return false;
    memcpy(request.beneficiary,beneficiary,3);
    const char* cursor=token;
    while (*cursor) {
        if (request.count==16 || *cursor<'1' || *cursor>'9') return false;
        uint64_t value=0;
        while (*cursor>='0' && *cursor<='9') {
            value=value*10+static_cast<unsigned>(*cursor-'0');
            if (value>2147483647u) return false;
            ++cursor;
        }
        for (unsigned i=0;i<request.count;++i)
            if (request.ids[i]==static_cast<int32_t>(value)) return false;
        request.ids[request.count++]=static_cast<int32_t>(value);
        if (!*cursor) break;
        if (*cursor++!=',' || !*cursor) return false;
    }
    return request.count!=0;
}

static bool peace_province_query_prepare(void* offer,const PeaceProvinceRequest& request,
    PeaceProvinceQueryData& data,bool demand=true) noexcept {
    if (!data.valid() || request.count>16) return false;
    data.expected_direction=demand?1u:0u;
    data.requested_count=request.count;
    data.selection_requested=request.count!=0;
    memcpy(data.requested_ids,request.ids,sizeof(request.ids));
    memcpy(data.requested_beneficiary_tag,request.beneficiary,4);
    if (request.count && !alliance_query_country(request.beneficiary,
            data.requested_beneficiary)) return false;
    if (!peace_province_query_enumerate(offer,data)) return false;
    if (!request.count) return true;
    if (!data.enumeration_complete || !data.selected_term_records_complete) {
        data.reason_code="NATIVE_PEACE_PROVINCE_SELECTION_UNAVAILABLE";
        return true;
    }
    // Resolve every requested candidate before the first native mutation.
    if (!data.requested_candidates_found) return true;
    // These requests begin with a newly constructed offer.  An unexpected
    // preselected province requires a separate native deselection contract.
    if (data.selected_count) {
        data.reason_code="NATIVE_PEACE_PROVINCE_SELECTION_UNAVAILABLE";
        return true;
    }
    uintptr_t descriptor_method=0,recalculate=0;
    if (!read(base+peace_province_type3_vtable_rva+0x78,descriptor_method)
        || descriptor_method!=base+0x99adb0
        || !read(base+peace_province_type3_vtable_rva+0x118,recalculate)
        || recalculate!=base+0x9a8420) return false;
    using Descriptor=void* (*)(void*,void*);
    using DependencyUpdate=void (*)(void*,void*,unsigned char);
    using Recalculate=void (*)(void*,void*,unsigned char,unsigned char);
    using Append=void (*)(void*,uintptr_t,const uintptr_t*);
    using Aggregate=int32_t (*)(void*,unsigned char);
    const auto aggregate=reinterpret_cast<Aggregate>(base+0x978ed0);
    const int32_t before=aggregate(offer,1);
    const uintptr_t offer_address=reinterpret_cast<uintptr_t>(offer);
    for (unsigned i=0;i<request.count;++i) {
        for (unsigned j=0;j<data.candidate_count;++j) {
            auto& candidate=data.candidates[j];
            if (candidate.province_id!=request.ids[i]
                || candidate.beneficiary!=data.requested_beneficiary) continue;
            unsigned char selected=0,direction=0;
            alignas(8) unsigned char descriptor[16]{};
            void* term=reinterpret_cast<void*>(candidate.term);
            if (!read(candidate.term+0x20,selected) || selected
                || !read(offer_address+0x20,direction)
                || direction!=data.expected_direction
                || reinterpret_cast<Descriptor>(descriptor_method)(term,descriptor)!=descriptor)
                return false;
            uint32_t bucket=0; memcpy(&bucket,descriptor,sizeof(bucket));
            uintptr_t buckets=0; unsigned bucket_count=0;
            if (bucket!=3 || !peace_payload_span(offer_address,0xd0,24,
                    bridge::peace_payload::kPeaceBucketCount,buckets,bucket_count)
                || bucket>=bucket_count) return false;
            uintptr_t vector=buckets+static_cast<uintptr_t>(bucket)*24;
            uintptr_t begin=0,end=0,capacity=0;
            if (!read(vector,begin) || !read(vector+8,end)
                || !read(vector+16,capacity) || end<begin || capacity<end
                || (end-begin)%8 || (capacity-begin)%8
                || (end-begin)/8>=peace_province_max_candidates) return false;
            // This field update and vector insertion are the exact native
            // persistent construction sequence, not the speculative +120.
            selected=1;
            memcpy(reinterpret_cast<void*>(candidate.term+0x20),&selected,1);
            reinterpret_cast<DependencyUpdate>(base+0x97a4e0)(offer,term,1);
            // The native generator resolves the typed vector after notifying
            // other selected terms.  Keep that ordering and refresh its span.
            if (!peace_payload_span(offer_address,0xd0,24,
                    bridge::peace_payload::kPeaceBucketCount,buckets,bucket_count)
                || bucket>=bucket_count) return false;
            vector=buckets+static_cast<uintptr_t>(bucket)*24;
            if (!read(vector,begin) || !read(vector+8,end)
                || !read(vector+16,capacity) || end<begin || capacity<end
                || (end-begin)%8 || (capacity-begin)%8
                || (end-begin)/8>=peace_province_max_candidates) return false;
            if (end==capacity)
                reinterpret_cast<Append>(base+0x0cc220)(reinterpret_cast<void*>(vector),
                    end,&candidate.term);
            else {
                memcpy(reinterpret_cast<void*>(end),&candidate.term,sizeof(candidate.term));
                end+=8;
                memcpy(reinterpret_cast<void*>(vector+8),&end,sizeof(end));
            }
            reinterpret_cast<Recalculate>(recalculate)(term,
                reinterpret_cast<void*>(offer_address+0xe8),direction,0);
            reinterpret_cast<DependencyUpdate>(base+0x97a4e0)(offer,term,0);
            ++data.toggle_call_count;
            break;
        }
    }
    data.toggle_called=data.toggle_call_count!=0;
    const int64_t delta=static_cast<int64_t>(aggregate(offer,1))-before;
    data.selection_delta_available=delta>=(-2147483647ll-1) && delta<=2147483647ll;
    if (data.selection_delta_available) data.selection_delta_raw=static_cast<int32_t>(delta);
    if (!peace_province_query_read_selection(offer,data,PeaceProvinceSelectionRole::source)) return false;
    if (!data.parameters_matched && !data.reason_code)
        data.reason_code="NATIVE_PEACE_PROVINCE_SELECTION_MISMATCH";
    return true;
}
